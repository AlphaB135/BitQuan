# BitQuan Testnet Environment Variables
# Copy this file to .env and update with secure values

# Grafana Authentication for Testnet
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=securepassword123

# Network Configuration
BITQUAN_NETWORK=testnet
BITQUAN_DATA_DIR=/data

# RPC Configuration
RPC_URL=http://bitquan-node:8334

# Faucet Configuration
FAUCET_AMOUNT=100
COOLDOWN_HOURS=24

# Logging Configuration
RUST_LOG=info
RUST_BACKTRACE=1

# Security Configuration
BITQUAN_CONFIG=/config/testnet.toml

# Docker Network
BITQUAN_NETWORK_NAME=bitquan-net
