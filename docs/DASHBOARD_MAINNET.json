{
  "dashboard": {
    "title": "BitQuan Mainnet Monitoring",
    "tags": ["bitquan", "mainnet", "blockchain"],
    "timezone": "utc",
    "schemaVersion": 16,
    "version": 1,
    "refresh": "30s",
    "panels": [
      {
        "id": 1,
        "title": "Chain Height",
        "type": "graph",
        "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "chain_finalized_height",
            "legendFormat": "Finalized Height",
            "refId": "A"
          },
          {
            "expr": "stratum_blocks_persisted_total",
            "legendFormat": "Total Blocks",
            "refId": "B"
          }
        ],
        "yaxes": [
          {"format": "short", "label": "Block Height"},
          {"format": "short"}
        ]
      },
      {
        "id": 2,
        "title": "Network Peers",
        "type": "graph",
        "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "network_peers_connected",
            "legendFormat": "Connected Peers",
            "refId": "A"
          },
          {
            "expr": "network_peers_mainnet_total",
            "legendFormat": "Mainnet Peers (Est.)",
            "refId": "B"
          }
        ],
        "yaxes": [
          {"format": "short", "label": "Peer Count"},
          {"format": "short"}
        ]
      },
      {
        "id": 3,
        "title": "Mining Activity",
        "type": "graph",
        "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "rate(pow_mined_blocks_total[5m])",
            "legendFormat": "{{algo}} Blocks/min",
            "refId": "A"
          },
          {
            "expr": "pow_hashrate_gauge",
            "legendFormat": "{{algo}} Hashrate",
            "refId": "B"
          }
        ],
        "yaxes": [
          {"format": "short", "label": "Rate"},
          {"format": "Hs"}
        ]
      },
      {
        "id": 4,
        "title": "Rewards & Payouts",
        "type": "graph",
        "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "pool_mainnet_rewards_total",
            "legendFormat": "Total Rewards",
            "refId": "A"
          },
          {
            "expr": "stratum_pool_balance_gauge",
            "legendFormat": "Pool Balance",
            "refId": "B"
          },
          {
            "expr": "stratum_payouts_total",
            "legendFormat": "Payouts Completed",
            "refId": "C"
          }
        ],
        "yaxes": [
          {"format": "sat", "label": "Satoshis"},
          {"format": "short"}
        ]
      },
      {
        "id": 5,
        "title": "Block Propagation",
        "type": "graph",
        "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "rate(network_blocks_broadcast_total[5m])",
            "legendFormat": "Blocks Broadcast",
            "refId": "A"
          },
          {
            "expr": "rate(network_blocks_received_total[5m])",
            "legendFormat": "Blocks Received",
            "refId": "B"
          }
        ],
        "yaxes": [
          {"format": "short", "label": "Blocks/min"},
          {"format": "short"}
        ]
      },
      {
        "id": 6,
        "title": "Network Issues",
        "type": "graph",
        "gridPos": {"x": 12, "y": 16, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "rate(orphan_blocks_total[5m])",
            "legendFormat": "Orphan Rate",
            "refId": "A"
          },
          {
            "expr": "rate(peer_drops_total[5m])",
            "legendFormat": "Peer Drop Rate",
            "refId": "B"
          },
          {
            "expr": "rate(pow_verify_failures_total[5m])",
            "legendFormat": "PoW Verify Failures",
            "refId": "C"
          }
        ],
        "yaxes": [
          {"format": "short", "label": "Events/min"},
          {"format": "short"}
        ]
      },
      {
        "id": 7,
        "title": "Block Time",
        "type": "graph",
        "gridPos": {"x": 0, "y": 24, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "pow_block_time_seconds",
            "legendFormat": "{{algo}} Block Time",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "s", "label": "Seconds"},
          {"format": "short"}
        ],
        "alert": {
          "name": "Block Time Alert",
          "message": "Block time exceeds 900 seconds (15 minutes)",
          "conditions": [
            {
              "evaluator": {"params": [900], "type": "gt"},
              "operator": {"type": "and"},
              "query": {"params": ["A", "5m", "now"]},
              "reducer": {"params": [], "type": "avg"},
              "type": "query"
            }
          ]
        }
      },
      {
        "id": 8,
        "title": "Sync Status",
        "type": "stat",
        "gridPos": {"x": 12, "y": 24, "w": 6, "h": 4},
        "targets": [
          {
            "expr": "network_sync_active_gauge",
            "legendFormat": "Sync Active",
            "refId": "A"
          }
        ],
        "options": {
          "graphMode": "none",
          "colorMode": "value"
        },
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 1, "color": "yellow"}
              ]
            },
            "mappings": [
              {"value": 0, "text": "Idle"},
              {"value": 1, "text": "Syncing"}
            ]
          }
        }
      },
      {
        "id": 9,
        "title": "Reward Per Block",
        "type": "stat",
        "gridPos": {"x": 18, "y": 24, "w": 6, "h": 4},
        "targets": [
          {
            "expr": "reward_per_block_gauge",
            "legendFormat": "Reward",
            "refId": "A"
          }
        ],
        "options": {
          "graphMode": "none",
          "unit": "sat"
        }
      }
    ]
  }
}
