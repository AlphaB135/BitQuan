# BitQuan Testnet Environment Configuration

NETWORK=testnet
CHAIN_ID=bitquan-testnet-v1
DATA_DIR=/var/lib/bitquan/testnet
LOG_LEVEL=info
LOG_FILE=/var/log/bitquan/testnet.log

# P2P Configuration
P2P_PORT=18333
P2P_BIND=0.0.0.0:18333
MAX_PEERS=125

# RPC Configuration
RPC_PORT=18334
RPC_BIND=127.0.0.1:18334
RPC_ENABLED=true

# Stratum Mining Pool
STRATUM_PORT=13333
STRATUM_ENABLED=true

# Metrics & Monitoring
METRICS_PORT=9090
METRICS_ENABLED=true
PROMETHEUS_PUSH_GATEWAY=

# Bootstrap Nodes
BOOTSTRAP_NODES=testnet-seed1.bitquan.network:18333,testnet-seed2.bitquan.network:18333

# Database
DB_CACHE_SIZE_MB=512
DB_MAX_OPEN_FILES=1000
