# BitQuan Mainnet Environment Configuration

NETWORK=mainnet
CHAIN_ID=bitquan-mainnet-v1
DATA_DIR=/var/lib/bitquan/mainnet
LOG_LEVEL=warn
LOG_FILE=/var/log/bitquan/mainnet.log

# P2P Configuration
P2P_PORT=8333
P2P_BIND=0.0.0.0:8333
MAX_PEERS=250

# RPC Configuration
RPC_PORT=8334
RPC_BIND=127.0.0.1:8334
RPC_ENABLED=true

# Stratum Mining Pool
STRATUM_PORT=3333
STRATUM_ENABLED=true

# Metrics & Monitoring
METRICS_PORT=9090
METRICS_ENABLED=true
PROMETHEUS_PUSH_GATEWAY=http://prometheus.internal:9091

# Bootstrap Nodes (DNS seeds)
BOOTSTRAP_NODES=seed1.bitquan.network:8333,seed2.bitquan.network:8333,seed3.bitquan.network:8333

# Database
DB_CACHE_SIZE_MB=2048
DB_MAX_OPEN_FILES=4096

# Security
RPC_USER=admin
# RPC_PASSWORD should be set securely via environment or secret manager
